{
  "name": "ledgora",
  "version": "1.10.80",
  "private": true,
  "description": "Multi-tenant GST billing SaaS for India (monorepo). Evolved from Free GST Billing Software.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "pnpm --filter @ledgora/api start",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @ledgora/db migrate",
    "db:seed": "pnpm --filter @ledgora/db seed",
    "db:generate": "pnpm --filter @ledgora/db generate",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:build": "node docs-site/build.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@ledgora/config": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "railway": "^3.16.0",
    "sharp": "^0.35.5",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "prettier": "@ledgora/config/prettier"
}
