{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:smoke": {
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "PORT",
    "API_PORT",
    "DATA_DIR",
    "INVOICES_DIR",
    "TRASH_DIR",
    "VITE_ENABLE_BILL_SCAN",
    "SMOKE_FAIL_SHOT",
    "APP_URL"
  ]
}
