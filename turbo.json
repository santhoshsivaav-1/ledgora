{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:smoke": {
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "PORT",
    "API_PORT",
    "DATA_DIR",
    "INVOICES_DIR",
    "TRASH_DIR",
    "VITE_ENABLE_BILL_SCAN",
    "SMOKE_FAIL_SHOT",
    "APP_URL",
    "DATABASE_URL",
    "API_LISTEN_PORT",
    "RUN_MIGRATIONS",
    "AUTH_SECRET",
    "API_URL",
    "ALLOWED_ORIGINS",
    "REQUIRE_EMAIL_VERIFICATION",
    "SESSION_DAYS",
    "TRUST_PROXY",
    "RESEND_API_KEY",
    "MAIL_FROM",
    "SMTP_URL",
    "MSG91_AUTH_KEY",
    "MSG91_TEMPLATE_ID",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "RATE_LIMIT_ENABLED",
    "RATE_LIMIT_API_PER_MIN",
    "RATE_LIMIT_LOGIN_PER_MIN",
    "RATE_LIMIT_OTP_PER_10MIN",
    "DB_POOL_MAX",
    "FILE_SIGNING_SECRET",
    "LOCAL_FILES_DIR",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY"
  ]
}
