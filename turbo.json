{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:smoke": {
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "PORT",
    "API_PORT",
    "DATA_DIR",
    "INVOICES_DIR",
    "TRASH_DIR",
    "VITE_ENABLE_BILL_SCAN",
    "SMOKE_FAIL_SHOT",
    "APP_URL",
    "DATABASE_URL",
    "API_LISTEN_PORT",
    "DEV_ORG_ID",
    "RUN_MIGRATIONS",
    "DB_POOL_MAX",
    "FILE_SIGNING_SECRET",
    "LOCAL_FILES_DIR",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY"
  ]
}
