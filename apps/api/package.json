{
  "name": "@ledgora/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant REST API (Hono + Postgres). Also serves the built web app.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env src/server.ts",
    "backfill:ledger": "node --env-file-if-exists=../../.env src/backfillLedger.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "rehearse": "vitest run -c vitest.rehearsal.config.ts"
  },
  "devDependencies": {
    "@ledgora/config": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/s3-request-presigner": "^3.1167.0",
    "@hono/node-server": "^2.1.8",
    "@ledgora/contracts": "workspace:^",
    "@ledgora/db": "workspace:^",
    "@ledgora/tax-engine": "workspace:^",
    "better-auth": "^1.7.22",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "kysely": "0.29.8",
    "nodemailer": "^10.5.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  }
}
