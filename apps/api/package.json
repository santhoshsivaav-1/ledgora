{
  "name": "@ledgora/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant REST API (Hono + Postgres). Replaces apps/legacy-server.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@ledgora/config": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@hono/node-server": "^2.1.5",
    "@ledgora/contracts": "workspace:^",
    "@ledgora/db": "workspace:^",
    "@ledgora/tax-engine": "workspace:^",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "kysely": "0.29.7",
    "nodemailer": "^10.3.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  }
}
