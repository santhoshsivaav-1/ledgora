# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
#
# "Used now" values work today. "Planned" values are read by code that arrives in later phases
# (the phase number is in brackets); they are listed so the local services can be wired up once.

# ---- Used now: web app (apps/web) -----------------------------------------------------------
# Show "Import from image (OCR)" in Purchases. Leave false until OCR returns as a server job (6.10).
VITE_ENABLE_BILL_SCAN=false
# Shown on the public privacy policy and terms pages (apps/web/src/config/company.js). Leave the e-mail empty to show no address.
VITE_COMPANY_NAME=Ledgora
VITE_SUPPORT_EMAIL=

# ---- Planned [Phase 1]: database and API ----------------------------------------------------
# Matches docker-compose.yml. The API must connect as a role WITHOUT BYPASSRLS (see change 1.11).
DATABASE_URL=postgres://ledgora:ledgora@localhost:5432/ledgora
REDIS_URL=redis://localhost:6379
API_URL=http://localhost:4000
# Port the API listens on. Hosts like Railway set PORT instead; either works.
API_LISTEN_PORT=4000
# Folder of the built web app. The API serves it when it exists (default: apps/web/dist), so production is one service.
# WEB_DIST_DIR=
# Apply database migrations when the API starts (handy locally; production runs them as a deploy step).
RUN_MIGRATIONS=false
# File uploads (change 1.22). Leave S3_* empty locally: files are kept in apps/api/.local-files instead.
FILE_SIGNING_SECRET=dev-only-signing-secret-change-me
APP_URL=http://localhost:5173

# ---- Used now [Phase 2]: login and accounts ------------------------------------------------
# Signs sessions and one-time tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=dev-only-auth-secret-change-me-0123456789
# Public address of the API, used in e-mail links.
API_URL=http://localhost:4000
# Extra browser origins (comma separated) allowed to call the API with cookies, besides APP_URL.
ALLOWED_ORIGINS=
# A password account must confirm its e-mail before signing in. Currently off while e-mail sending is not set up; turn on (true) once Resend works.
REQUIRE_EMAIL_VERIFICATION=false
# Days a sign-in lasts.
SESSION_DAYS=30
# Honour X-Forwarded-For (needed behind a proxy so rate limits and the audit log see the real address).
TRUST_PROXY=false
# Mail: Resend in production. Without it the API uses SMTP_URL (Mailpit) and, in development, the outbox shown at /v1/console.
RESEND_API_KEY=
MAIL_FROM=Ledgora <no-reply@ledgora.local>
# With Docker running (docker compose up -d), uncomment to read mail at http://localhost:8025 (Mailpit):
# SMTP_URL=smtp://localhost:1025
# SMS login codes through MSG91. Leave empty locally: the code is printed to the API log and the console outbox.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Google sign-in turns on when both are set (Google Cloud console > Credentials > OAuth client; redirect URI: API_URL/v1/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Rate limits per caller address.
# IFSC → bank branch lookup on the Add Bank Account form. The API server calls this directory (the browser never does).
# Leave as is for Razorpay's open IFSC API, or set it to off to work offline (only bundled bank names are used).
IFSC_API_URL=https://ifsc.razorpay.com
# An API call slower than this many milliseconds is logged as [slow] (0 = off). Every call also answers a Server-Timing header.
SLOW_REQUEST_MS=1000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MIN=1500
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_OTP_PER_10MIN=5

# ---- Planned [Phase 4]: payments (use TEST keys outside production) --------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# One Razorpay plan per plan and period. The plan's amount is the price PLUS 18% GST (e.g. Silver yearly = 2999 + GST = 3538.82):
# the GST invoice splits the amount that was charged.
RAZORPAY_PLAN_IDS=silver:month=,silver:year=,gold:month=,gold:year=
# Who issues the GST invoice for a subscription (leave SELLER_GSTIN empty until you are registered).
SELLER_NAME=Ledgora
SELLER_GSTIN=
SELLER_STATE=Tamil Nadu
SELLER_ADDRESS=
SELLER_GST_RATE=18
# The people who run this service: they alone see Platform admin (every subscriber, plan and e-mail). Comma separated,
# addresses must be confirmed, and the page stays closed while REQUIRE_EMAIL_VERIFICATION is off.
PLATFORM_ADMIN_EMAILS=
# GST service provider for e-invoice (IRN), e-way bill and GSTN upload. off | sandbox | http. sandbox is a built-in stand-in for trying
# the screens (its IRNs are marked and not valid); http needs a provider behind the contract in docs/GSP_INTEGRATION.md.
GSP_MODE=off
GSP_BASE_URL=
GSP_API_KEY=
# Where data-protection requests (access, correction, erasure) are mailed.
SUPPORT_EMAIL=
# A new business starts with the ledger and Cash & Bank on. Set false to start bare.
LEDGER_ON_SIGNUP=true

# ---- Planned [Phase 5]: files and monitoring ------------------------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SENTRY_DSN=

# Phase 7: scheduled backups are encrypted with a password derived from this (falls back to AUTH_SECRET). Rotating it
# makes older scheduled backups unreadable. Google Drive backups use GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above, with the
# Drive API enabled and ${API_URL}/v1/backups/drive/callback added as a redirect URI.
# BACKUP_ENCRYPTION_KEY=

# R2 income tax: the software id the Income Tax Department issues to this platform (SW + 8 digits), one for all customers.
# Without it the ITR-4 file carries a placeholder and the build screen warns. See docs/R2_MANUAL_STEPS.md.
# ITR_SW_CODE=
