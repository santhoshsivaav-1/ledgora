# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
#
# "Used now" values work today. "Planned" values are read by code that arrives in later phases
# (the phase number is in brackets); they are listed so the local services can be wired up once.

# ---- Used now: legacy single-user server (apps/legacy-server) -------------------------------
# Port the parked Express server listens on (the Vite dev server proxies /api to it).
PORT=47371
# Where the legacy server keeps its JSON files. Default is data/ at the repo root.
# DATA_DIR=
# INVOICES_DIR=
# TRASH_DIR=

# ---- Used now: web app (apps/web) -----------------------------------------------------------
# Port of the legacy server, for the Vite dev proxy. Must match PORT above.
API_PORT=47371
# Show "Import from image (OCR)" in Purchases. Leave false until OCR returns as a server job (6.10).
VITE_ENABLE_BILL_SCAN=false

# ---- Planned [Phase 1]: database and API ----------------------------------------------------
# Matches docker-compose.yml. The API must connect as a role WITHOUT BYPASSRLS (see change 1.11).
DATABASE_URL=postgres://ledgora:ledgora@localhost:5432/ledgora
REDIS_URL=redis://localhost:6379
API_URL=http://localhost:4000
# Port the new API listens on (not API_PORT, which is the legacy server's port above).
API_LISTEN_PORT=4000
# Until login ships (Phase 2) the API needs to know which organization you are. This is the demo one created by `pnpm db:seed`.
DEV_ORG_ID=00000000-0000-4000-8000-000000000001
# Apply database migrations when the API starts (handy locally; production runs them as a deploy step).
RUN_MIGRATIONS=false
# File uploads (change 1.22). Leave S3_* empty locally: files are kept in apps/api/.local-files instead.
FILE_SIGNING_SECRET=dev-only-signing-secret-change-me
APP_URL=http://localhost:5173

# ---- Planned [Phase 2]: login ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-a-real-secret
# Local mail goes to Mailpit (docker-compose.yml); read it at http://localhost:8025
SMTP_URL=smtp://localhost:1025
# SMS provider for phone OTP (MSG91). Leave empty locally: the OTP is printed to the API log.
MSG91_AUTH_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Planned [Phase 4]: payments (use TEST keys outside production) --------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Planned [Phase 5]: files and monitoring ------------------------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SENTRY_DSN=
