# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
#
# "Used now" values work today. "Planned" values are read by code that arrives in later phases
# (the phase number is in brackets); they are listed so the local services can be wired up once.

# ---- Used now: legacy single-user server (apps/legacy-server) -------------------------------
# Port the parked Express server listens on (the Vite dev server proxies /api to it).
PORT=47371
# Where the legacy server keeps its JSON files. Default is data/ at the repo root.
# DATA_DIR=
# INVOICES_DIR=
# TRASH_DIR=

# ---- Used now: web app (apps/web) -----------------------------------------------------------
# Port of the legacy server, for the Vite dev proxy. Must match PORT above.
API_PORT=47371
# Show "Import from image (OCR)" in Purchases. Leave false until OCR returns as a server job (6.10).
VITE_ENABLE_BILL_SCAN=false

# ---- Planned [Phase 1]: database and API ----------------------------------------------------
# Matches docker-compose.yml. The API must connect as a role WITHOUT BYPASSRLS (see change 1.11).
DATABASE_URL=postgres://ledgora:ledgora@localhost:5432/ledgora
REDIS_URL=redis://localhost:6379
API_URL=http://localhost:4000
# Port the new API listens on (not API_PORT, which is the legacy server's port above).
API_LISTEN_PORT=4000
# Apply database migrations when the API starts (handy locally; production runs them as a deploy step).
RUN_MIGRATIONS=false
# File uploads (change 1.22). Leave S3_* empty locally: files are kept in apps/api/.local-files instead.
FILE_SIGNING_SECRET=dev-only-signing-secret-change-me
APP_URL=http://localhost:5173

# ---- Used now [Phase 2]: login and accounts ------------------------------------------------
# Signs sessions and one-time tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=dev-only-auth-secret-change-me-0123456789
# Public address of the API, used in e-mail links.
API_URL=http://localhost:4000
# Extra browser origins (comma separated) allowed to call the API with cookies, besides APP_URL.
ALLOWED_ORIGINS=
# A password account must confirm its e-mail before signing in. Keep true outside of automated tests.
REQUIRE_EMAIL_VERIFICATION=true
# Days a sign-in lasts.
SESSION_DAYS=30
# Honour X-Forwarded-For (needed behind a proxy so rate limits and the audit log see the real address).
TRUST_PROXY=false
# Mail: Resend in production. Without it the API uses SMTP_URL (Mailpit) and, in development, the outbox shown at /v1/console.
RESEND_API_KEY=
MAIL_FROM=Ledgora <no-reply@ledgora.local>
# With Docker running (docker compose up -d), uncomment to read mail at http://localhost:8025 (Mailpit):
# SMTP_URL=smtp://localhost:1025
# SMS login codes through MSG91. Leave empty locally: the code is printed to the API log and the console outbox.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Google sign-in turns on when both are set (Google Cloud console > Credentials > OAuth client; redirect URI: API_URL/v1/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Rate limits per caller address.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_OTP_PER_10MIN=5

# ---- Planned [Phase 4]: payments (use TEST keys outside production) --------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Planned [Phase 5]: files and monitoring ------------------------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SENTRY_DSN=
